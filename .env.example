# Optional LLM provider. If unset, generation uses a deterministic local fallback.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional MongoDB. If unset, generated test cases are stored in generated/generations.json.
MONGODB_URI=
MONGODB_DATABASE=tri9t_ct200
DATABASE_URL=sqlite:///./ct200.db
